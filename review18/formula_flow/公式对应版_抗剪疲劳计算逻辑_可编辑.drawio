<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram name="公式对应版｜抗剪疲劳主循环" id="calc0"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="2600"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="公式对应版｜抗剪疲劳主循环" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="5" width="1560" height="45" /></mxCell><mxCell id="footer" value="F＝2019抗弯疲劳modeling论文；S＝2019单裂缝抗剪论文；E＝2024 ECC-FRP抗剪论文。公式号必须带论文前缀。" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="2520" width="1510" height="65" /></mxCell><mxCell id="start" value="开始：输入真实试件与峰谷总荷载 Qmax、Qmin" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="60" width="570" height="80" /></mxCell><mxCell id="input" value="准备裂缝与筋的真实交点、两侧锚固长度&#10;初始化 N=0、局部龄期 Ni=0、最大滑移和失效记录&#10;parameters / prepare_parameters / fatigue_calculate" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="185" width="570" height="120" /></mxCell><mxCell id="initial" value="依次求初始峰值和谷值抗剪平衡&#10;Vc(q)+Vs(q)+Vf(q)=Qmax/2 或 Qmin/2&#10;state → trial；内部计算见第2页" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="350" width="570" height="120" /></mxCell><mxCell id="ok0" value="初始峰、谷求解成功？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="510" width="570" height="100" /></mxCell><mxCell id="limit" value="N &lt; Nmax？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="655" width="570" height="100" /></mxCell><mxCell id="active" value="根据峰谷滑移判断本步活跃节点&#10;(smax&gt;0.75δm 或曾激活)，且峰谷滑移差&gt;容差&#10;active_nodes｜F：阈值；历史保持与容差为代码规则" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="795" width="570" height="120" /></mxCell><mxCell id="on" value="有活跃节点或启用了&#10;其他材料 S–N 退化？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="960" width="570" height="110" /></mxCell><mxCell id="step" value="选取循环块 ΔN，不跨越下一快照或 Nmax&#10;从已接受历史提出候选：Ni,new=Ni,old+ΔN&#10;仅活跃节点增加龄期；候选尚不提交" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1110" width="570" height="120" /></mxCell><mxCell id="proposal" value="更新节点峰值黏结应力 [F式2]&#10;τm,i=max{0,[1−kf log₁₀max(Ni,1)]τm,0}&#10;kf=0.1965（杆）或0.1985（条）｜bond_strength" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1270" width="570" height="120" /></mxCell><mxCell id="peak" value="将 τm,i 代入黏结本构，重新求峰值平衡&#10;由裂缝位移q → 滑移场 → 筋力 → 抗剪力&#10;state → trial → anchorage / bond（见第2页）" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1430" width="570" height="120" /></mxCell><mxCell id="retry" value="峰值失败或 q 增长过快，&#10;且 ΔN &gt; 1？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1590" width="570" height="110" /></mxCell><mxCell id="peakok" value="候选峰值平衡成功？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1740" width="570" height="100" /></mxCell><mxCell id="low" value="继承峰值最大滑移历史，求谷值平衡&#10;当前FRP黏结应力＝历史割线刚度×当前滑移&#10;state → trial；谷值目标剪力 Qmin/2" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1880" width="570" height="120" /></mxCell><mxCell id="lowok" value="候选谷值平衡成功？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2040" width="570" height="100" /></mxCell><mxCell id="accept" value="接受本循环块：N←N+ΔN，提交候选历史&#10;保存 q、w、v、Vc、Vs、Vf 与局部滑移/应变/失效&#10;fatigue_calculate / save_snapshot" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2180" width="570" height="120" /></mxCell><mxCell id="output" value="停止并输出最后有效状态&#10;export_results；达到Nmax为runout，不等于疲劳寿命" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2360" width="570" height="110" /></mxCell><mxCell id="half" value="减小循环块&#10;ΔN←max[1,floor(ΔN/2)]&#10;从同一份已接受历史重算" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="1255" width="330" height="140" /></mxCell><mxCell id="stop" value="记录停止原因&#10;局部数值失败 / 用户限制 /&#10;域内指定分支无平衡根&#10;不能统一写成“脱黏破坏”" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE2DE;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="2040" width="330" height="160" /></mxCell><mxCell id="runout" value="达到循环上限&#10;记录runout" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="655" width="300" height="100" /></mxCell><mxCell id="inactive" value="没有可演化退化项&#10;记录快照至Nmax&#10;无活跃退化runout" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="960" width="300" height="120" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="input"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input" target="initial"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="initial" target="ok0"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="是：保存N=0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ok0" target="limit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ok0" target="stop"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1510" y="560" /><mxPoint x="1510" y="2120" /></Array></mxGeometry></mxCell><mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="limit" target="active"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="limit" target="runout"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="runout" target="output"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="20" y="705" /><mxPoint x="20" y="2415" /></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="active" target="on"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="on" target="step"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="on" target="inactive"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inactive" target="output"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="20" y="1020" /><mxPoint x="20" y="2415" /></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step" target="proposal"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="proposal" target="peak"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="peak" target="retry"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="retry" target="half"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1475" y="1645" /><mxPoint x="1475" y="1325" /></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="half" target="proposal"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1060" y="1325" /><mxPoint x="1060" y="1330" /></Array></mxGeometry></mxCell><mxCell id="e17" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="retry" target="peakok"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="peakok" target="low"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e19" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="peakok" target="stop"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1070" y="1790" /><mxPoint x="1070" y="2120" /></Array></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="low" target="lowok"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e21" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lowok" target="accept"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e22" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lowok" target="stop"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e23" value="下一循环块" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="accept" target="limit"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="375" y="2240" /><mxPoint x="375" y="705" /></Array></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="stop" target="output"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1285" y="2415" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="公式对应版｜抗剪平衡内部求解" id="calc1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="2550"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="公式对应版｜抗剪平衡内部求解" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="5" width="1560" height="45" /></mxCell><mxCell id="footer" value="F：DOI 10.1016/j.ijfatigue.2019.04.039；S：DOI尾号0000953；E：DOI尾号CCENG-4395。橙色包含附加假定。" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="2470" width="1510" height="65" /></mxCell><mxCell id="start" value="给定峰/谷目标剪力与已接受历史，选取试探 q&#10;state：扫描上升符号变化及二分；不提交试探历史" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="65" width="570" height="105" /></mxCell><mxCell id="crack" value="① 裂缝运动（当前代码的指定关系）&#10;g(y)=(1−y/hc)^m；K=cosθ+r sinθ&#10;w₀=q/K；v₀=rw₀；w(y)=w₀g(y)，v(y)=v₀g(y)&#10;crack_deformation｜未实现S式7的PST/Green求解" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="215" width="570" height="145" /></mxCell><mxCell id="vc" value="② 混凝土抗剪贡献（经验闭合，不是所给论文原式）&#10;Vc=Vc0(1−exp(−q/qr))&#10;×[ρc+(1−ρc)exp(−w₀/wc)](1−Dc)&#10;trial｜各经验参数需标定" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="405" width="570" height="140" /></mxCell><mxCell id="vs" value="③ 穿缝箍筋贡献&#10;εs,j=qg(yj)/ls；σs,j=min(Esεs,j,fy)；Vs=ΣAs,jσs,j&#10;应变传力长度ls为代码假定；损伤达到1时该筋应力归零&#10;trial｜应力上限/离散求和有R22式9a、9c背景" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="590" width="570" height="140" /></mxCell><mxCell id="bar" value="④ 对每根未失效FRP筋，计算裂缝运动投影&#10;δj=qg(yj)[sin(θ+αj)−r cos(θ+αj)]/K&#10;竖向筋αj=90°时：δj=qg(yj)&#10;trial｜不是直接照搬S式8" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="775" width="570" height="140" /></mxCell><mxCell id="tm" value="⑤ 由节点局部龄期更新 τm,i [F式2]&#10;τm,i=max{0,τm,0[1−kf log₁₀max(Ni,1)]}&#10;bond_strength；Ni为激活后局部循环数" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="960" width="570" height="115" /></mxCell><mxCell id="bond" value="⑥ 三段黏结包络 [F式1]，令 tr=min(τr,τm,i)&#10;τenv=τm,i·s/δm                       s≤δm&#10;τenv=tr+(τm,i−tr)(δu−s)/(δu−δm)   δm&lt;s≤δu&#10;τenv=tr                            s&gt;δu&#10;bond：tr取min及历史割线规则为代码补充" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1120" width="570" height="180" /></mxCell><mxCell id="anchor" value="⑦ 双侧锚固离散求解与节点应力积分&#10;dT/dx=−pfτ；ds/dx=−T/(EfAf)；自由端T=0&#10;Ti(x)=pf∫[x,Li]τi(ξ)dξ；anchorage / anchor_mesh&#10;积分原理：F式10、S式10；积分区间按本锚固段改写" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1345" width="570" height="150" /></mxCell><mxCell id="compat" value="⑧ 满足两侧协调与交点应变连续&#10;s₁(0)+s₂(0)=δj [S式9d]；εf1(0)=εf2(0) [S式11]&#10;同一根筋EfAf相同，因此T₁(0)=T₂(0)&#10;数值迭代求解，未直接使用F式9b或S式9a–c解析解" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1540" width="570" height="150" /></mxCell><mxCell id="fail" value="⑨ 检查本根筋脱黏、抗拉与用户保护层限值&#10;失效筋贡献归零；重复④—⑨处理其他筋&#10;trial：筋轴力上限为Af·ffu，目前没有FRP本体疲劳律" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1735" width="570" height="125" /></mxCell><mxCell id="sum" value="⑩ 汇总竖向FRP抗剪力及整体平衡&#10;Vf=nfaces ΣTj sinαj；V=Vc+Vs+Vf=Q/2&#10;总分解与E式1同一平衡思想；此处第三项是NSM筋&#10;不使用ECC覆盖层的 Vef,σ+Vef,τ 分解" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1905" width="570" height="150" /></mxCell><mxCell id="ok" value="局部求解有效，且&#10;|V(q)−Q/2|≤forceTolerance？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2100" width="570" height="115" /></mxCell><mxCell id="return" value="返回该峰/谷的平衡解：q、材料分量与局部场&#10;供总控制器判断是否接受循环块" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2265" width="570" height="100" /></mxCell><mxCell id="more" value="还有可继续的&#10;扫描/二分搜索？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="2100" width="330" height="115" /></mxCell><mxCell id="diag" value="返回分类诊断&#10;无指定分支根 / 数值失败 / 分辨率限制&#10;未把“无解”直接归为抗弯IC脱黏破坏" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE2DE;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="2265" width="330" height="140" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="crack"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="crack" target="vc"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="vc" target="vs"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="vs" target="bar"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bar" target="tm"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tm" target="bond"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bond" target="anchor"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="anchor" target="compat"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="compat" target="fail"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fail" target="sum"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sum" target="ok"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ok" target="return"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ok" target="more"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" value="是：调整q" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="more" target="start"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1510" y="2157" /><mxPoint x="1510" y="117" /></Array></mxGeometry></mxCell><mxCell id="e14" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="more" target="diag"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram name="公式采用范围与当前实现" id="calc2"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="2100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="公式采用范围与当前实现" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="5" width="1560" height="45" /></mxCell><mxCell id="footer" value="R22：DOI尾号0001251，支持穿缝筋应力与离散贡献背景；本轮保留当前源码，仅重画公式对应的计算逻辑。" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="2020" width="1510" height="65" /></mxCell><mxCell id="a" value="你找出的公式，在当前抗剪代码中如何取舍" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="80" width="1080" height="85" /></mxCell><mxCell id="b" value="采用：F式(1)三段包络、F式(2)局部疲劳退化&#10;对应bond.m、bond_strength.m；0.75δm阈值用于active_nodes.m&#10;注意代码对零龄期、负峰值与残余值另有数值处理" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="230" width="1080" height="150" /></mxCell><mxCell id="c" value="原理改写：F式(10)与S式(10)的黏结应力积分&#10;原文半跨坐标改为每根筋裂缝交点两侧的局部坐标：Ti(x)=pf∫[x,Li]τi dξ&#10;S式(9d)、(11)提供双侧滑移协调、交点应变连续的背景" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="460" width="1080" height="170" /></mxCell><mxCell id="d" value="当前未直接实现：F式(9b)解析系数矩阵、S式(9a–c)分段解析解&#10;anchorage.m实际组装杆单元与黏结刚度，并进行固定点/Newton数值迭代&#10;两种矩阵写法不能仅因外观相似就标为同一个方程" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="710" width="1080" height="170" /></mxCell><mxCell id="e" value="当前不纳入：F式(11)的Ps/Pd、F式(13)的半跨Ls/Ld关系&#10;它们服务于纵向加固的抗弯IC脱黏模型；P也不是本抗剪算例的总加载力Q&#10;当前代码没有按这些式子计算临界荷载和半跨软化/脱黏长度" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="960" width="1080" height="170" /></mxCell><mxCell id="f" value="当前不纳入：F式(14)的纵向加固梁挠度&#10;竖向NSM抗剪不能直接使用该偏心纵向筋的弯曲挠度表达式&#10;当前的q、裂缝法向开口w与该文挠度w不是同一个物理量" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="1210" width="1080" height="170" /></mxCell><mxCell id="g" value="平衡思想可采用：E式(1) V=Vc+Vs+Vef&#10;在本模型改写为V=Vc+Vs+Vf；Vf来自实际NSM筋竖向分量&#10;E式(2)的Vef,σ+Vef,τ用于ECC连续覆盖层，当前NSM筋代码未实现" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="1460" width="1080" height="180" /></mxCell><mxCell id="h" value="图示的是当前代码的计算路线，源码没有改变&#10;若要真正实现F式(9b)、(11)、(13)或S完整裂缝理论，需要另行建模与验证&#10;本轮不将这些尚未实现的公式画成已经运行的计算步骤" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="1730" width="1080" height="160" /></mxCell></root></mxGraphModel></diagram></mxfile>