<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram name="抗剪疲劳计算主流程" id="calc0"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="2630"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="抗剪疲劳计算主流程" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="5" width="1560" height="45" /></mxCell><mxCell id="footer" value="[F19] DOI:10.1016/j.ijfatigue.2019.04.039；kf=0.1965(杆)/0.1985(条)。默认只启用界面疲劳。" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="2550" width="1510" height="65" /></mxCell><mxCell id="start" value="开始：定义一个抗剪疲劳算例" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="60" width="570" height="70" /></mxCell><mxCell id="input" value="输入试件、材料、黏结参数与峰谷总荷载&#10;目标剪力：Vmax=Qmax/2；Vmin=Qmin/2&#10;parameters / read_and_calculate" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="170" width="570" height="110" /></mxCell><mxCell id="init" value="计算真实交点、两侧锚固长度与箍筋位置&#10;初始化 N=0、最大滑移、局部龄期和失效记录&#10;prepare_parameters / fatigue_calculate" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="320" width="570" height="110" /></mxCell><mxCell id="initial" value="依次求初始峰值、谷值平衡（局部求解见第2页）&#10;Vc(q)+Vs(q)+Vf(q)=Qmax/2 或 Qmin/2&#10;可选 capacity_scan 仅作初始静力诊断" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="470" width="570" height="110" /></mxCell><mxCell id="initok" value="初始峰、谷状态&#10;都求解成功？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="620" width="570" height="100" /></mxCell><mxCell id="limit" value="N &lt; Nmax？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="765" width="570" height="100" /></mxCell><mxCell id="active" value="由峰谷滑移确定疲劳活跃节点&#10;曾激活或 smax&gt;ηδm，且滑移差&gt;容差（η默认0.75）&#10;active_nodes｜[F19：阈值；其余为实现规则]" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="905" width="570" height="110" /></mxCell><mxCell id="on" value="有活跃节点，或启用了&#10;箍筋/混凝土 S–N 规则？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1055" width="570" height="110" /></mxCell><mxCell id="step" value="选择循环块 ΔN&#10;不超过cycleStep、剩余循环数与下一快照位置&#10;fatigue_calculate" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1205" width="570" height="100" /></mxCell><mxCell id="proposal" value="从已接受历史建立候选历史，不覆盖原历史&#10;活跃节点：Nloc,new=Nloc,old+ΔN&#10;可选S–N/Miner更新；默认关闭" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1345" width="570" height="110" /></mxCell><mxCell id="peak" value="按候选龄期更新 τm，并重新求峰值平衡&#10;τm=max{0,τm0[1−kf log₁₀max(Nloc,1)]} [F19式2]&#10;state → trial → bond_strength / anchorage" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1495" width="570" height="120" /></mxCell><mxCell id="retry" value="峰值失败或 q 增长过快，&#10;并且 ΔN &gt; 1？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1655" width="570" height="110" /></mxCell><mxCell id="peakok" value="候选峰值平衡成功？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1805" width="570" height="100" /></mxCell><mxCell id="valley" value="继承候选峰值的最大滑移历史，求谷值平衡&#10;Vc(qmin)+Vs(qmin)+Vf(qmin)=Qmin/2&#10;state（卸载）" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1945" width="570" height="110" /></mxCell><mxCell id="lowok" value="候选谷值平衡成功？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2095" width="570" height="100" /></mxCell><mxCell id="commit" value="接受循环块：N←N+ΔN，提交候选历史&#10;记录抗剪分量、裂缝位移、残差及失效标志&#10;history_row / save_snapshot" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2235" width="570" height="110" /></mxCell><mxCell id="output" value="结束并输出最后有效结果&#10;export_results：曲线、局部场、MAT / CSV / PNG" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2405" width="570" height="100" /></mxCell><mxCell id="runout" value="达到 Nmax&#10;标记 runout，不代表已破坏" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="765" width="300" height="100" /></mxCell><mxCell id="inactive" value="无可演化的退化项&#10;沿快照记录至 Nmax&#10;标记无活跃退化runout" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1055" width="300" height="120" /></mxCell><mxCell id="half" value="ΔN←max[1, floor(ΔN/2)]&#10;回到同一份已接受历史重试" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="1345" width="330" height="100" /></mxCell><mxCell id="initialstop" value="初始求解未成功&#10;记录初始模型限制或数值诊断" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE2DE;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="620" width="330" height="110" /></mxCell><mxCell id="stop" value="记录停止原因&#10;数值不收敛 ≠ 物理破坏&#10;无指定分支平衡根＝模型限制&#10;保留最后已接受状态" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE2DE;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="2075" width="330" height="150" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="input"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input" target="init"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="init" target="initial"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="initial" target="initok"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="是：保存N=0结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="initok" target="limit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="initok" target="initialstop"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="initialstop" target="stop"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1510" y="675" /><mxPoint x="1510" y="2150" /></Array></mxGeometry></mxCell><mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="limit" target="active"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="limit" target="runout"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="runout" target="output"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="20" y="815" /><mxPoint x="20" y="2455" /></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="active" target="on"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="on" target="step"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="on" target="inactive"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inactive" target="output"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="20" y="1115" /><mxPoint x="20" y="2455" /></Array></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step" target="proposal"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="proposal" target="peak"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="peak" target="retry"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e17" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="retry" target="half"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1070" y="1710" /><mxPoint x="1070" y="1395" /></Array></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="half" target="proposal"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1040" y="1395" /><mxPoint x="1040" y="1400" /></Array></mxGeometry></mxCell><mxCell id="e19" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="retry" target="peakok"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e20" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="peakok" target="valley"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e21" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="peakok" target="stop"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1480" y="1855" /><mxPoint x="1480" y="2150" /></Array></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="valley" target="lowok"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e23" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lowok" target="commit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e24" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lowok" target="stop"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e25" value="下一循环块" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="commit" target="limit"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="375" y="2290" /><mxPoint x="375" y="815" /></Array></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="stop" target="output"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1285" y="2455" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="峰谷抗剪平衡的内部计算" id="calc1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="1900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="峰谷抗剪平衡的内部计算" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="5" width="1560" height="45" /></mxCell><mxCell id="footer" value="[S19] DOI:10.1061/(ASCE)CC.1943-5614.0000953；[R22] DOI尾号0001251。Vc、g、r、ls含代码假定；未实现S19式7。" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="1820" width="1510" height="65" /></mxCell><mxCell id="start" value="给定目标剪力 Vtarget 与已接受历史 memory&#10;峰值取Qmax/2，谷值取Qmin/2" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="70" width="570" height="100" /></mxCell><mxCell id="q" value="选择试探 q：扫描上升符号变化并二分&#10;峰值：q≥上次峰值；谷值：0≤q≤峰值q&#10;state：每个试探使用同一份已接受历史" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="215" width="570" height="110" /></mxCell><mxCell id="crack" value="计算裂缝运动&#10;g(y)=(1−y/hc)^m；K=cosθ+r sinθ&#10;w₀=q/K；v₀=rw₀｜crack_deformation" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="370" width="570" height="110" /></mxCell><mxCell id="concrete" value="计算混凝土和穿缝箍筋的抗剪贡献&#10;Vc=当前经验闭合函数 Vc(q,Dc)&#10;εs=qg/ls；σs=min(Esεs,fy)；Vs=ΣAsσs｜trial" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="525" width="570" height="110" /></mxCell><mxCell id="bar" value="对每根未失效的穿缝FRP筋计算裂缝位移投影&#10;δj=qg(yj)[sin(θ+αj)−r cos(θ+αj)]/K&#10;竖向筋α=90°时：δj=qg(yj)｜trial" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="680" width="570" height="110" /></mxCell><mxCell id="tm" value="由各节点局部龄期计算退化峰值 τm&#10;τm=max{0,τm0[1−kf log₁₀max(Nloc,1)]}&#10;bond_strength｜[F19式2]" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="835" width="570" height="110" /></mxCell><mxCell id="anchor" value="离散两侧锚固段，迭代黏结刚度与滑移&#10;s₁(0)+s₂(0)=δj；T₁(0)=T₂(0)；自由端T=0&#10;anchorage / anchor_mesh / bond｜[S19式9d、10、11]" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="990" width="570" height="120" /></mxCell><mxCell id="fail" value="检查本根筋是否脱黏、达到抗拉或用户上限&#10;失效筋贡献归零；然后处理下一根筋&#10;trial：不把一根筋失效直接等同整梁破坏" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1155" width="570" height="110" /></mxCell><mxCell id="sum" value="汇总FRP竖向分量及总抗剪力&#10;Vf=nfaces ΣTj sinαj；V(q)=Vc+Vs+Vf&#10;trial｜方向投影与分量平衡 [R22式9a–d]" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1310" width="570" height="110" /></mxCell><mxCell id="balanced" value="局部求解有效，且&#10;|V(q)−Vtarget|≤forceTolerance？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1465" width="570" height="120" /></mxCell><mxCell id="return" value="返回本次峰值或谷值的平衡响应&#10;供总控制器检查是否接受候选循环块" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1630" width="570" height="100" /></mxCell><mxCell id="more" value="尚有扫描点或&#10;有效二分搜索可继续？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="1465" width="330" height="120" /></mxCell><mxCell id="diag" value="停止本次平衡搜索并返回分类诊断&#10;数值失败 / 分支分辨率限制 / 无域内平衡根&#10;不是统一标记为脱黏破坏" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE2DE;strokeColor=#6A7E90;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="1630" width="330" height="130" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="q"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q" target="crack"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0