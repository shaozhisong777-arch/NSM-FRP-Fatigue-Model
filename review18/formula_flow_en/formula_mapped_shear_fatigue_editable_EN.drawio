<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram name="Formula-Mapped Shear Fatigue Main Loop" id="calc0"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="2600"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Formula-Mapped Shear Fatigue Main Loop" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="5" width="1560" height="45" /></mxCell><mxCell id="footer" value="F: 2019 flexural-fatigue modeling paper; S: 2019 single-crack shear paper; E: 2024 ECC-FRP paper. Equation numbers need a paper prefix." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="2520" width="1510" height="65" /></mxCell><mxCell id="start" value="Start: specify the specimen and total loads Qmax, Qmin" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="60" width="570" height="80" /></mxCell><mxCell id="input" value="Locate actual crack–reinforcement intersections&#10;Initialize N=0, local counts Ni=0 and slip/failure history&#10;parameters / prepare_parameters / fatigue_calculate" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="185" width="570" height="120" /></mxCell><mxCell id="initial" value="Solve initial peak and valley shear equilibrium in order&#10;Vc(q)+Vs(q)+Vf(q)=Qmax/2 or Qmin/2&#10;state → trial; internal calculation on page 2" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="350" width="570" height="120" /></mxCell><mxCell id="ok0" value="Initial peak and valley&#10;solutions successful?" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="510" width="570" height="100" /></mxCell><mxCell id="limit" value="N &lt; Nmax?" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="655" width="570" height="100" /></mxCell><mxCell id="active" value="Identify active nodes from peak–valley slip&#10;(smax&gt;0.75δm or previously activated) AND slip range&gt;tol&#10;active_nodes | F: threshold; history/range gates: code rules" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="795" width="570" height="120" /></mxCell><mxCell id="on" value="Active nodes, or enabled&#10;steel/concrete S–N rules?" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="960" width="570" height="110" /></mxCell><mxCell id="step" value="Choose ΔN without passing the next snapshot or Nmax&#10;Propose Ni,new=Ni,old+ΔN at active nodes only&#10;Keep the accepted history unchanged until acceptance" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1110" width="570" height="120" /></mxCell><mxCell id="proposal" value="Update nodal peak bond stress [F, Eq. 2]&#10;τm,i=max{0,[1−kf log₁₀max(Ni,1)]τm,0}&#10;kf=0.1965 (rod) or 0.1985 (strip) | bond_strength" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1270" width="570" height="120" /></mxCell><mxCell id="peak" value="Use the updated bond law to solve peak equilibrium&#10;Crack jump q → slip profiles → bar forces → shear&#10;state → trial → anchorage / bond (page 2)" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1430" width="570" height="120" /></mxCell><mxCell id="retry" value="Peak failed or q grew too fast,&#10;AND ΔN &gt; 1?" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1590" width="570" height="110" /></mxCell><mxCell id="peakok" value="Candidate peak&#10;equilibrium successful?" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1740" width="570" height="100" /></mxCell><mxCell id="low" value="Use peak maximum-slip history to solve the valley state&#10;FRP bond stress = historical secant stiffness × current slip&#10;state → trial; valley shear target Qmin/2" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1880" width="570" height="120" /></mxCell><mxCell id="lowok" value="Candidate valley&#10;equilibrium successful?" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2040" width="570" height="100" /></mxCell><mxCell id="accept" value="Accept the block: N←N+ΔN; commit candidate history&#10;Save q, w, v, Vc, Vs, Vf and local slip/strain/failure fields&#10;fatigue_calculate / save_snapshot" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2180" width="570" height="120" /></mxCell><mxCell id="output" value="Stop and export the last accepted response&#10;export_results; reaching Nmax is a runout, not fatigue life" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2360" width="570" height="110" /></mxCell><mxCell id="half" value="Reduce the cycle block&#10;ΔN←max[1,floor(ΔN/2)]&#10;Retry from the same accepted history" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="1255" width="330" height="140" /></mxCell><mxCell id="stop" value="Record the stopping reason&#10;Numerical failure / user limit /&#10;no root on the selected branch&#10;Do not label every stop as debonding" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE2DE;strokeColor=#6A7E90;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="2040" width="330" height="160" /></mxCell><mxCell id="runout" value="Cycle limit reached&#10;Report runout" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="655" width="300" height="100" /></mxCell><mxCell id="inactive" value="No active degradation mechanism&#10;Record snapshots up to Nmax&#10;Report runout without degradation" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="960" width="300" height="120" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="input"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input" target="initial"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="initial" target="ok0"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="Yes: save N=0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ok0" target="limit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ok0" target="stop"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1510" y="560" /><mxPoint x="1510" y="2120" /></Array></mxGeometry></mxCell><mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="limit" target="active"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="limit" target="runout"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="runout" target="output"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="20" y="705" /><mxPoint x="20" y="2415" /></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="active" target="on"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="on" target="step"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="on" target="inactive"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inactive" target="output"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="20" y="1020" /><mxPoint x="20" y="2415" /></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step" target="proposal"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="proposal" target="peak"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="peak" target="retry"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="retry" target="half"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1475" y="1645" /><mxPoint x="1475" y="1325" /></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="half" target="proposal"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1060" y="1325" /><mxPoint x="1060" y="1330" /></Array></mxGeometry></mxCell><mxCell id="e17" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="retry" target="peakok"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="peakok" target="low"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e19" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="peakok" target="stop"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1070" y="1790" /><mxPoint x="1070" y="2120" /></Array></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="low" target="lowok"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e21" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lowok" target="accept"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e22" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lowok" target="stop"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e23" value="Next block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="accept" target="limit"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="375" y="2240" /><mxPoint x="375" y="705" /></Array></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="stop" target="output"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1285" y="2415" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Formula-Mapped Shear Equilibrium Solver" id="calc1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="2550"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Formula-Mapped Shear Equilibrium Solver" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="5" width="1560" height="45" /></mxCell><mxCell id="footer" value="F: DOI 10.1016/j.ijfatigue.2019.04.039; S: DOI suffix 0000953; E: CCENG-4395. Orange boxes include model assumptions." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="2470" width="1510" height="65" /></mxCell><mxCell id="start" value="Set the peak/valley target and accepted history; trial q&#10;state: ascending-bracket scan and bisection; no trial commit" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="65" width="570" height="105" /></mxCell><mxCell id="crack" value="1. Crack kinematics (prescribed code relations)&#10;g(y)=(1−y/hc)^m; K=cosθ+r sinθ&#10;w₀=q/K; v₀=rw₀; w(y)=w₀g(y); v(y)=v₀g(y)&#10;crack_deformation | S, Eq. 7 (PST/Green) not implemented" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="215" width="570" height="145" /></mxCell><mxCell id="vc" value="2. Concrete shear (empirical code closure)&#10;Vc=Vc0(1−exp(−q/qr))&#10;×[ρc+(1−ρc)exp(−w₀/wc)](1−Dc)&#10;trial | empirical parameters require calibration" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="405" width="570" height="140" /></mxCell><mxCell id="vs" value="3. Contribution of stirrups intersecting the crack&#10;εs,j=qg(yj)/ls; σs,j=min(Esεs,j,fy); Vs=ΣAs,jσs,j&#10;ls is assumed; stirrup stress is zero when damage reaches 1&#10;trial | stress cap/sum: R22, Eqs. 9a, 9c" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="590" width="570" height="140" /></mxCell><mxCell id="bar" value="4. Project crack motion onto each intact FRP bar&#10;δj=qg(yj)[sin(θ+αj)−r cos(θ+αj)]/K&#10;For vertical bars (αj=90°): δj=qg(yj)&#10;trial | not a direct substitution of S, Eq. 8" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="775" width="570" height="140" /></mxCell><mxCell id="tm" value="5. Update τm,i using local cycle counts [F, Eq. 2]&#10;τm,i=max{0,τm,0[1−kf log₁₀max(Ni,1)]}&#10;bond_strength; Ni counts local cycles after activation" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="960" width="570" height="115" /></mxCell><mxCell id="bond" value="6. Trilinear bond envelope [F, Eq. 1]; tr=min(τr,τm,i)&#10;τenv=τm,i·s/δm                         s≤δm&#10;τenv=tr+(τm,i−tr)(δu−s)/(δu−δm)    δm&lt;s≤δu&#10;τenv=tr                               s&gt;δu&#10;bond | residual clipping and secant history: code additions" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1120" width="570" height="180" /></mxCell><mxCell id="anchor" value="7. Discretize both anchors and integrate bond stress&#10;dT/dx=−pfτ; ds/dx=−T/(EfAf); free-end T=0&#10;Ti(x)=pf∫[x,Li]τi(ξ)dξ | anchorage / anchor_mesh&#10;F, Eq. 10; S, Eq. 10: adapted to local anchor coordinates" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1345" width="570" height="150" /></mxCell><mxCell id="compat" value="8. Enforce two-sided compatibility and strain continuity&#10;s₁(0)+s₂(0)=δj [S, Eq. 9d]; εf1(0)=εf2(0) [S, Eq. 11]&#10;The same EfAf on both sides gives T₁(0)=T₂(0)&#10;Numerical iteration; not F, Eq. 9b or S, Eqs. 9a–c" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1540" width="570" height="150" /></mxCell><mxCell id="fail" value="9. Check debonding, tensile and user cover limits&#10;Remove failed-bar force; repeat steps 4–9 for other bars&#10;trial: tensile cap Af·ffu; no FRP material-fatigue law yet" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF0F3;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1735" width="570" height="125" /></mxCell><mxCell id="sum" value="10. Sum FRP vertical forces and total shear&#10;Vf=nfaces ΣTj sinαj; V=Vc+Vs+Vf=Q/2&#10;Same force-decomposition idea as E, Eq. 1; Vf is NSM shear&#10;The ECC-overlay split Vef,σ+Vef,τ is not used" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="1905" width="570" height="150" /></mxCell><mxCell id="ok" value="Valid local solution AND&#10;|V(q)−Q/2|≤forceTolerance?" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2100" width="570" height="115" /></mxCell><mxCell id="return" value="Return the balanced peak/valley state and local fields&#10;The controller decides whether to accept the cycle block" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="2265" width="570" height="100" /></mxCell><mxCell id="more" value="Further scan/bisection&#10;search available?" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="2100" width="330" height="115" /></mxCell><mxCell id="diag" value="Return a classified diagnostic&#10;No selected-branch root /&#10;numerical failure / resolution limit&#10;No automatic IC-debonding label" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE2DE;strokeColor=#6A7E90;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1120" y="2265" width="330" height="140" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="crack"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="crack" target="vc"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="vc" target="vs"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="vs" target="bar"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bar" target="tm"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tm" target="bond"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bond" target="anchor"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="anchor" target="compat"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="compat" target="fail"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fail" target="sum"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sum" target="ok"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ok" target="return"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ok" target="more"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" value="Yes: adjust q" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="more" target="start"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1510" y="2157" /><mxPoint x="1510" y="117" /></Array></mxGeometry></mxCell><mxCell id="e14" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#1685B6;fontColor=#B8302E;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="more" target="diag"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram name="Equation Scope and Current Implementation" id="calc2"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="2100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Equation Scope and Current Implementation" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="5" width="1560" height="45" /></mxCell><mxCell id="footer" value="R22: DOI suffix 0001251, intersecting reinforcement and shear-force decomposition. This update translates the diagrams only." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="2020" width="1510" height="65" /></mxCell><mxCell id="a" value="How the supplied equations relate to the current shear code" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="80" width="1080" height="85" /></mxCell><mxCell id="b" value="Adopted: F, Eq. (1), trilinear envelope; F, Eq. (2), local fatigue degradation&#10;bond.m / bond_strength.m; the 0.75δm threshold is used in active_nodes.m&#10;The code adds zero-count protection, nonnegative peaks and a residual-stress rule." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="230" width="1080" height="150" /></mxCell><mxCell id="c" value="Adapted principle: bond-stress integration in F, Eq. (10), and S, Eq. (10)&#10;Replace half-span coordinates with local coordinates on each anchor: Ti(x)=pf∫[x,Li]τi dξ&#10;S, Eqs. (9d) and (11), motivate two-sided slip compatibility and intersection strain continuity." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="460" width="1080" height="170" /></mxCell><mxCell id="d" value="Not directly implemented: F, Eq. (9b), analytical matrix; S, Eqs. (9a–c), analytical slip fields&#10;anchorage.m assembles bar/bond stiffness and uses fixed-point iteration with a Newton fallback.&#10;The numerical system is not the paper matrix merely because both are written as matrix equations." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="710" width="1080" height="170" /></mxCell><mxCell id="e" value="Not included: Ps/Pd from F, Eq. (11), and half-span Ls/Ld relations from F, Eq. (13)&#10;These belong to the longitudinal flexural IC-debonding model; its P is not this model’s total load Q.&#10;The current code does not calculate critical loads or half-span damage-zone lengths using these equations." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="960" width="1080" height="170" /></mxCell><mxCell id="f" value="Not included: longitudinally strengthened beam deflection from F, Eq. (14)&#10;The eccentric longitudinal-reinforcement bending expression does not transfer directly to vertical NSM shear.&#10;Here q is a vertical crack jump and w is crack opening; the paper’s deflection w is a different quantity." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE9CD;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="1210" width="1080" height="170" /></mxCell><mxCell id="g" value="Adopted equilibrium idea: E, Eq. (1), V=Vc+Vs+Vef&#10;Here V=Vc+Vs+Vf, where Vf sums the actual NSM bar-force vertical components.&#10;E, Eq. (2), Vef,σ+Vef,τ, concerns the continuous ECC overlay and is not implemented for these NSM bars." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3E9;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="1460" width="1080" height="180" /></mxCell><mxCell id="h" value="This diagram describes the current calculation; the MATLAB source remains unchanged.&#10;Implementing F, Eqs. (9b), (11), (13), or the complete S crack model requires separate modeling and validation.&#10;Equations not yet implemented are not presented as executed calculation steps." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F0FF;strokeColor=#6A7E90;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="1730" width="1080" height="160" /></mxCell></root></mxGraphModel></diagram></mxfile>